# Copy this file to .env and fill in the values (never commit .env)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=cinema_db
DB_USER=your_db_user
DB_PASS=your_password_here
# Path to the CA certificate, or the certificate text itself (needed by managed MySQL such as Aiven)
DB_CA_CERT=/path/to/ca.pem
